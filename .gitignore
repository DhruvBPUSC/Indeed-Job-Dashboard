# Dependencies
node_modules/

# Build output and generated code (rebuilt by `npm install` / `npm run build`)
dist/
src/generated/
*.tsbuildinfo

# Test coverage reports
coverage/

# Environment files: never commit real configuration or secrets.
.env*
!.env.example
# .env.test is committed on purpose: the test suite loads it. It holds only the local Docker
# test database's credentials and test-only values, no real secrets.
!.env.test

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor and tool settings
.vscode/
.idea/
*.swp
*.swo
*~
.claude/settings.local.json

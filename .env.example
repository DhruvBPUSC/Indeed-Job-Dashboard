# Copy to .env and adjust. Values below match docker-compose.yml.
NODE_ENV=development
PORT=3000

# Dev database (docker compose service "db")
DATABASE_URL=postgresql://tracker:tracker@localhost:5432/tracker_dev?schema=public

# Used to sign auth JWTs. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed to call the API with cookies (CORS). Comma-separate several.
FRONTEND_URL=http://localhost:5173

# Auth cookie SameSite: lax (frontend and API on the same site, e.g. localhost) or none
# (different sites, e.g. two *.onrender.com subdomains; production only). See DEPLOY.md.
COOKIE_SAMESITE=lax

# Rate limit for /api/auth/*: max requests per IP per window (default 20 per 15 minutes)
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Password for the seeded demo account (demo@example.com). Used only by npm run db:seed.
SEED_DEMO_PASSWORD=DemoPass123!

# fatal | error | warn | info | debug | trace | silent (default: info; silent in tests)
LOG_LEVEL=info

# Max JSON request body (larger requests get 413)
BODY_LIMIT=100kb

# Reverse proxies in front of the app (0 = none). Set to 1 behind Render/Railway/nginx so
# rate limiting sees the real client IP.
TRUST_PROXY=0

# How long graceful shutdown waits for in-flight requests (ms)
SHUTDOWN_TIMEOUT_MS=10000

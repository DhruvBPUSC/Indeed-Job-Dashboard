# Loaded automatically when NODE_ENV=test (Vitest sets this).
# Local-only credentials for the docker compose "db-test" service; not secrets.
NODE_ENV=test
PORT=3001
DATABASE_URL=postgresql://tracker:tracker@localhost:5433/tracker_test?schema=public
JWT_SECRET=test-only-secret-that-is-at-least-32-characters-long
JWT_EXPIRES_IN=1h
FRONTEND_URL=http://localhost:5173
SEED_DEMO_PASSWORD=DemoPass123!

# High limit so the suite never trips it; the rate-limit test builds its own app with a low limit.
AUTH_RATE_LIMIT_MAX=1000
